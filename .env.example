# =============================================================
# COPIE ESTE ARCHIVO COMO ".env" y ajuste los valores.
# En produccion (hosting) use valores distintos y NUNCA suba .env
# =============================================================

# development | production
APP_ENV=development

# URL publica del proyecto (en XAMPP incluye /carniceria)
# Desarrollo (XAMPP):  http://localhost/carniceria
# Produccion:          https://www.tudominio.com
APP_URL=http://localhost/carniceria

# Base de datos - DESARROLLO (XAMPP por defecto: root sin clave)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=carniceria_db
DB_USER=root
DB_PASS=

# Base de datos - PRODUCCION (ejemplo, reemplazar en el hosting)
# DB_HOST=localhost
# DB_NAME=u12345_carniceria
# DB_USER=u12345_admin
# DB_PASS=clave_segura_de_hosting
